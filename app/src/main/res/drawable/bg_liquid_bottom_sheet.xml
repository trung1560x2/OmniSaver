<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="32dp"
                android:topRightRadius="32dp" />
            <gradient
                android:angle="135"
                android:startColor="#90FFFFFF"
                android:centerColor="#4038BDF8"
                android:endColor="#70A855F7"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="31dp"
                android:topRightRadius="31dp" />
            <gradient
                android:angle="270"
                android:startColor="#F2141E3D"
                android:centerColor="#F50D142B"
                android:endColor="#FA080C1C"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
