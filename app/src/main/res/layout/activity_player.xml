<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootPlayerContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_liquid_aurora_canvas">

    <!-- iOS 27 Spatial Aurora Orbs Glowing Behind Player -->
    <com.omnisaver.videodownloader.ui.LiquidGlassView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Video / Audio Surface -->
    <VideoView
        android:id="@+id/videoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- Audio Visual Placeholder (Floating VisionOS / iOS 27 Liquid Glass Card when playing MP3/Audio) -->
    <LinearLayout
        android:id="@+id/layoutAudioArtwork"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/bg_liquid_glass_card_accent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="136dp"
            android:layout_height="136dp"
            android:background="@drawable/bg_liquid_glass_pill"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="68dp"
            app:cardElevation="0dp"
            app:strokeColor="#9938BDF8"
            app:strokeWidth="1.5dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_liquid_glass_pill">

                <ImageView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_gravity="center"
                    android:contentDescription="Đang phát âm thanh"
                    android:src="@android:drawable/ic_lock_silent_mode_off"
                    android:tint="#7DD3FC" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvAudioNowPlayingTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:text="Đang phát âm thanh MP3"
            android:textColor="#F8FAFC"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAudioPlatformSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_liquid_glass_pill"
            android:paddingHorizontal="14dp"
            android:paddingVertical="5dp"
            android:text="Trình phát âm thanh OmniSaver"
            android:textColor="#7DD3FC"
            android:textSize="12.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Fullscreen Image Viewer -->
    <ImageView
        android:id="@+id/ivFullImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:contentDescription="Xem hình ảnh"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <!-- Floating iOS 27 Top Liquid Glass Overlay Capsule -->
    <LinearLayout
        android:id="@+id/topOverlayBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="14dp"
        android:background="@drawable/bg_liquid_glass_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnPlayerBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_liquid_glass_pill"
            android:contentDescription="Quay lại"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="#F8FAFC" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPlayerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:singleLine="true"
                android:text="Tên tệp"
                android:textColor="#F8FAFC"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPlayerSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="OmniSaver Spatial Player"
                android:textColor="#7DD3FC"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlayerShare"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_liquid_glass_pill"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="14dp"
            android:text="Chia sẻ"
            android:textAllCaps="false"
            android:textColor="#F8FAFC"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:cornerRadius="19dp"
            app:icon="@android:drawable/ic_menu_share"
            app:iconSize="16dp"
            app:iconTint="#7DD3FC"
            app:strokeWidth="0dp" />
    </LinearLayout>

    <!-- Floating VisionOS / iOS 27 Bottom Media Controls Capsule -->
    <LinearLayout
        android:id="@+id/bottomControlsBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="14dp"
        android:background="@drawable/bg_liquid_glass_card_accent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCurrentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#F8FAFC"
                android:textSize="12sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekBarProgress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:max="1000"
                android:progressBackgroundTint="#4D94A3B8"
                android:progressTint="#38BDF8"
                android:thumbTint="#7DD3FC" />

            <TextView
                android:id="@+id/tvTotalDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnRewind"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_liquid_glass_pill"
                android:contentDescription="Tua lùi 10 giây"
                android:src="@android:drawable/ic_media_rew"
                android:tint="#F8FAFC" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="28dp"
                android:layout_marginEnd="28dp"
                android:background="@drawable/bg_liquid_button_primary"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageButton
                    android:id="@+id/btnPlayPause"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_liquid_button_primary"
                    android:contentDescription="Phát / Tạm dừng"
                    android:src="@android:drawable/ic_media_pause"
                    android:tint="#FFFFFF" />
            </com.google.android.material.card.MaterialCardView>

            <ImageButton
                android:id="@+id/btnFastForward"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_liquid_glass_pill"
                android:contentDescription="Tua tới 10 giây"
                android:src="@android:drawable/ic_media_ff"
                android:tint="#F8FAFC" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
